  "knowledge": [
    {
      "id": "deposit-insurance",
      "category": "bank",
      "depth": "quick",
      "title": "存款保險是什麼？",
      "revisedOn": "2026-11-09",
      "body": "存款保險是在要保金融機構發生事故時，依規定保障合格存款的制度。一般情形下，最高保額按每位存款人在同一家要保機構計算。同一家機構即使有數個帳戶，也要合併計算符合保障的本金及利息。想確認哪些款項受保障，可查中央存保公司的說明及保額試算。",
      "sources": [
        {
          "name": "中央存保公司｜保額試算與說明",
          "url": "https://www.cdic.gov.tw/main_estimate/index.aspx"
        }
      ]
    },
    {
      "id": "etf",
      "category": "investment-trust",
      "depth": "quick",
      "title": "ETF 是什麼？",
      "revisedOn": "2026-11-09",
      "body": "ETF 是可在交易市場買賣的基金。投資人可透過證券帳戶下單，交易方式類似買賣股票。被動式 ETF 以貼近標的指數表現為目標，主動式 ETF 則由經理人依公開的投資策略配置資產。ETF 的價格會隨市場變動。要了解一檔 ETF，可先看它的投資目標、所持資產及費用。",
      "sources": [
        {
          "name": "臺灣證券交易所｜ETF 總覽",
          "url": "https://www.twse.com.tw/zh/products/securities/etf/overview/introduction.html"
        }
      ]
    }
  ]
